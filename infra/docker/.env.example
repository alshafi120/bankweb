# Copy to infra/docker/.env and fill every value. Never commit the real file.
WEB_HOST=www.example.ye
ADMIN_HOST=admin.example.ye
API_HOST=api.example.ye
MEDIA_HOST=media.example.ye
# Office/VPN ranges allowed to reach the admin dashboard (comma-free single CIDR; extend in nginx template for more)
ADMIN_ALLOW_CIDR=10.0.0.0/8
TLS_DIR=./tls

APP_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
S3_KEY=
S3_SECRET=
REVALIDATE_SECRET=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# First super admin (used once by `php artisan db:seed --class=AdminUserSeeder`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
