# ── Withaq Bank — Public website ──
# Public API base (server-side only, never sent to the browser).
# Leave unset to run on the built-in demo content and demo form submissions.
# API_BASE_URL=https://api.example.ye/api/v1

# Canonical site origin used for canonical URLs, hreflang, Open Graph, sitemap and robots (runtime, server-side).
SITE_URL=https://www.example.ye

# Shared secret the API uses to call POST /api/revalidate after publishing (server-side only).
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Optional: Cloudflare Turnstile. The site key itself comes from CMS settings; set this so the CSP allows Turnstile.
# TURNSTILE_SITE_KEY=
