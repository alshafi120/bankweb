# ─────────────────────────────────────────────────────────────────────────────
#  Withaq Bank API — environment. Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="Withaq Bank API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.bank.ye
APP_TIMEZONE=Asia/Aden
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# First-party frontends (CORS allow-list, reset-password links)
FRONTEND_URL=https://www.bank.ye
ADMIN_URL=https://admin.bank.ye

# Sanctum SPA (cookie) auth — admin host(s) only, comma separated, host[:port]
SANCTUM_STATEFUL_DOMAINS=admin.bank.ye
SESSION_DOMAIN=

# Reverse proxies (Cloudflare → Nginx). CIDRs of the proxy network, or * if only the proxy can reach PHP.
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=withaq_cms
DB_USERNAME=withaq_cms
DB_PASSWORD=

# Sessions: database driver (needed for "active sessions" management), 15 min idle timeout
SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (staff notifications, password resets)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@bank.ye
MAIL_FROM_NAME="${APP_NAME}"
# Optional fixed recipients for new-request notifications (comma separated); empty → users with <kind>.view
FORMS_NOTIFY_EMAIL=

# Media (public) — local "public" disk in dev; "s3" (S3-compatible) in production
MEDIA_DISK=public
MEDIA_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Base for signed private-file URLs as seen by the admin browser (same-origin proxy)
SIGNED_URL_BASE=https://admin.bank.ye/backend
# ClamAV daemon for upload scanning (empty → disabled), e.g. unix:///var/run/clamav/clamd.ctl
CLAMAV_SOCKET=

# Cloudflare Turnstile — empty secret disables verification (local dev only!)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Public form rate limits per IP per form
FORMS_PER_MINUTE=5
FORMS_PER_DAY=30
PUBLIC_CACHE_TTL=300

# Next.js on-demand ISR (apps/web/src/app/api/revalidate)
FRONTEND_REVALIDATE_URL=https://www.bank.ye/api/revalidate
REVALIDATE_SECRET=

# Admin security
ADMIN_REQUIRE_2FA=true
ADMIN_IP_ALLOWLIST=

# First super admin (php artisan db:seed --class=AdminUserSeeder). Password: ≥ 12 chars, upper, lower,
# digit and symbol. Remove ADMIN_PASSWORD from the environment after seeding.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# LOCAL ONLY (APP_ENV=local): password for the per-role demo users (demo.<role>), seeded by DemoUsersSeeder.
DEMO_USERS_PASSWORD=

# Integration layer: record intents in integration_outbox (v1 never calls core banking)
INTEGRATION_OUTBOX_ENABLED=false
