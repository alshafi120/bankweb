# ── Withaq Bank — Admin Dashboard ──
# Demo mode: in-memory mock API with fictional seed data (no backend needed).
# Also enabled automatically when API_ORIGIN is unset.
NEXT_PUBLIC_DEMO_MODE=true

# Real mode: Laravel API origin (server-side only — used by the /backend/* rewrite, never sent to the browser).
# API_ORIGIN=https://api.example.ye

# Optional: CDN origin for media thumbnails, added to the CSP img-src/media-src (server-side only).
# MEDIA_ORIGIN=https://media.example.ye
